# Copy this file to ".env" in the backend/ folder and fill in your key.
# Get a free API key at: https://console.groq.com/keys

GROQ_API_KEY=your_groq_api_key_here

# Optional: override the vision model Groq uses (defaults to qwen3.6-27b,
# Groq's current vision-capable model as of Aug 2026 — check
# https://console.groq.com/docs/vision if this ever 404s again, Groq
# periodically retires older model IDs)
# GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Optional: transactions at or above this AI-reported confidence (0-1) are
# auto-approved instead of landing in the review queue, so you don't have to
# manually approve every single high-confidence bill. Default 0.95. Set to
# 1.01 to disable auto-approve entirely (review everything).
# AUTO_APPROVE_CONFIDENCE=0.95

# --- Tally integration ---
# Tally Prime must have its built-in HTTP/XML server enabled:
#   Tally > F1 (Help) > Settings > Connectivity > Client/Server configuration
#   > enable "TallyPrime acts as" > "Server", and note the port (default 9000).
# TALLY_HOST=localhost
# TALLY_PORT=9000
