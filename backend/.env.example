# TEasy Environment Configuration (100% Offline & On-Premise)

# Processing Engine Mode (offline)
AI_PROVIDER=offline

# Optional: Tesseract command path (if not in standard Windows Program Files or PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Tally integration ---
# Tally Prime must have its built-in HTTP/XML server enabled:
#   Tally > F1 (Help) > Settings > Connectivity > Client/Server configuration
#   > enable "TallyPrime acts as" > "Server", and note the port (default 9000).
TALLY_HOST=localhost
TALLY_PORT=9000

# --- Licensing (Optional) ---
# TEASY_LICENSE_SERVICE_URL=http://localhost:9000
# TEASY_LICENSE_GRACE_DAYS=5
