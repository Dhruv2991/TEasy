# Copy to .env for local testing. On Railway/Render, set these as dashboard
# env vars instead — don't upload .env there.

# Postgres connection string. Locally this can be left unset and the service
# falls back to a local SQLite file (license.db) — fine for testing, but use
# real Postgres (e.g. a free Railway/Neon instance) in production, since a
# SQLite file on most hosts is wiped on redeploy.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Razorpay dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# Razorpay dashboard -> Subscriptions -> Plans -> create a monthly plan,
# paste its plan_id here (starts with plan_)
RAZORPAY_PLAN_ID=plan_xxxxxxxxxxxx

# Razorpay dashboard -> Settings -> Webhooks -> create a webhook pointing to
# https://<this-service>/billing/webhook, subscribe to the subscription.*
# events listed in README.md, and paste the webhook secret it gives you here.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# How many days a new email gets before the trial locks
TRIAL_DAYS=7

# How many days the app is allowed to run without successfully reaching this
# service before it locks (covers "no internet today", not "cancelled").
GRACE_DAYS=5

# Comma-separated list of browser origins allowed to call this service
# (your landing page's real domain). Falls back to "*" if unset — fine for
# local testing, but always set this explicitly in production.
ALLOWED_ORIGINS=https://t-easy.vercel.app
